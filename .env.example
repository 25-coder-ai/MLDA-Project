# Copy to .env to override defaults (all optional)
TRUSTCODE_SANDBOX_BACKEND=local        # local | docker
TRUSTCODE_DOCKER_RUNTIME=              # runsc for gVisor kernel isolation
TRUSTCODE_REDIS_URL=                   # redis://localhost:6379/0 enables Celery dispatch
TRUSTCODE_MAX_MUTANTS=10
TRUSTCODE_TRUSTED_THRESHOLD=80
TRUSTCODE_UNCERTAIN_THRESHOLD=50
TRUSTCODE_W_BASE=50
TRUSTCODE_W_SUPPORTED=25
TRUSTCODE_W_UNSUPPORTED=15
TRUSTCODE_W_CONTRADICTED=35
TRUSTCODE_W_HALLUCINATED=50
